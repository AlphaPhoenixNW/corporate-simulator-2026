{
  "name": "corporate-simulator-2026",
  "version": "0.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-webapp.mjs",
    "preview": "vite preview",
    "build:playtest": "npm run build && node scripts/package-playtest.mjs",
    "test:playtest": "node scripts/smoke-playtest.mjs",
    "test:webapp": "node scripts/smoke-webapp.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {"react": "19.1.1", "react-dom": "19.1.1"},
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@playwright/test": "1.55.0",
    "typescript": "5.8.3",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "engines": {"node": ">=22.12.0"}
}
